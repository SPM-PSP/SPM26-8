# 后端 API（可选）
# 开发时默认用 /api，由 Vite 代理到本机 8080，局域网同伴访问 http://你的IP:5173 即可
# 若不用 dev 代理、要直连后端，例如：VITE_API_BASE_URL=http://192.168.1.100:8080/api
# VITE_API_BASE_URL=

# 使用说明（二选一）：
# 方式 A（推荐）：复制本文件为 .env.local，填入 Key 后重启 npm run dev
# 方式 B：在 app/config/ai.config.ts 的 apiKey 中填写（优先级高于下方环境变量）
#
# 注意：仅 .env / .env.local 会被 Vite 加载，本 .env.example 文件不会生效！

VITE_AI_API_KEY=sk-8b4dd1162ce84c228fa86d60f5cf4278
VITE_AI_BASE_URL=https://api.deepseek.com
VITE_AI_MODEL=deepseek-chat

# 其他示例：
# 通义: VITE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  VITE_AI_MODEL=qwen-turbo
# OpenAI: VITE_AI_BASE_URL=https://api.openai.com  VITE_AI_MODEL=gpt-4o-mini
